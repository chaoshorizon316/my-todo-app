/* 心汐 全局样式 */
page {
  background-color: #FDF8F6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #3D4A52;
  font-size: 28rpx;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #3D4A52;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.btn-primary {
  background-color: #E8815B;
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-outline {
  background: transparent;
  color: #E8815B;
  border: 2rpx solid #E8815B;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  text-align: center;
}
