/* 涟漪页 · 对齐 V10 */

.page { padding: 0 32rpx; min-height: 100vh; }

.header { padding: 36rpx 0 20rpx; }
.title { font-size: 40rpx; font-family: var(--font-display); letter-spacing: 0.04em; display: block; }
.sub { font-size: 22rpx; color: var(--secondary); margin-top: 4rpx; display: block; }

.section-label { font-size: 20rpx; color: var(--secondary); letter-spacing: 0.1em; margin-bottom: 16rpx; display: block; }

/* 墨水图表 · 时间序列 */
.chart-card { padding: 28rpx; position: relative; overflow: hidden; }
.time-chart { display: flex; align-items: flex-end; justify-content: space-between; gap: 6rpx; }
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; min-width: 0; }
.chart-bar-wrap { width: 100%; max-width: 72rpx; background: rgba(23,24,24,0.06); border-radius: 4rpx 4rpx 0 0; position: relative; }
.chart-bar { width: 100%; border-radius: 4rpx 4rpx 0 0; min-height: 4rpx; transition: height 0.8s ease; position: absolute; bottom: 0; }
.chart-label { font-size: 18rpx; color: var(--secondary); text-align: center; margin-top: 8rpx; white-space: nowrap; }

/* 雾气分隔线 */
.mist-line { height:1rpx; background: linear-gradient(90deg,transparent,rgba(211,211,211,0.5),transparent); margin: 24rpx 0; }

/* 时间线 */
.tl-item { display: flex; align-items: flex-start; gap: 14rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--surface-container); }
.tl-ring {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 2rpx solid; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; position: relative;
}
.tl-ring::after { content:''; position:absolute; inset:-4rpx; border-radius:50%; border:1rpx solid; opacity:0.15; }
.tl-ring-icon { font-family: 'Material Symbols Outlined'; font-size: 28rpx; color: var(--secondary); }
.tl-content { flex: 1; min-width: 0; }
.tl-mood { font-size: 26rpx; display: block; }
.tl-note { font-size: 20rpx; color: var(--secondary); opacity: 0.7; margin-top: 2rpx; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tl-time { font-size: 20rpx; color: var(--secondary); white-space: nowrap; flex-shrink: 0; padding-top: 6rpx; }

.empty-msg { text-align: center; padding: 60rpx 0; }
.empty-icon { font-size: 56rpx; display: block; margin-bottom: 12rpx; }
.empty-msg text { font-size: 26rpx; color: var(--secondary); display: block; }
.empty-sub { font-size: 20rpx; opacity: 0.5; margin-top: 6rpx; display: block; }
.load-more { text-align: center; padding: 24rpx; color: var(--secondary); opacity: 0.4; font-size: 22rpx; }
