.page { padding: 0 32rpx; min-height: 100vh; }
.header { padding: 36rpx 0 20rpx; }
.title { font-size: 40rpx; font-family: var(--font-display); letter-spacing: 0.04em; display: block; }
.sub { font-size: 22rpx; color: var(--secondary); margin-top: 4rpx; display: block; }

.profile-card { display: flex; align-items: center; gap: 24rpx; padding: 28rpx; position: relative; overflow: hidden; }
.profile-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-container), var(--surface-container-high));
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 600; color: #fff; flex-shrink: 0;
}
.profile-name { font-size: 36rpx; font-weight: 600; display: block; }
.profile-tags { display: flex; gap: 10rpx; margin-top: 8rpx; }
.tag { padding: 6rpx 20rpx; border-radius: 100rpx; border: 1rpx solid var(--outline-variant); font-size: 22rpx; color: var(--secondary); }

.tab-bar { display: flex; justify-content: center; gap: 52rpx; margin: 28rpx 0 16rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid var(--surface-container); }
.tab { font-size: 28rpx; color: var(--secondary); opacity: 0.5; padding-bottom: 12rpx; transition: all 0.3s; }
.tab.active { opacity: 1; color: var(--primary); border-bottom: 3rpx solid var(--primary); }

.bond-list { display: flex; flex-direction: column; gap: 10rpx; }
.bond-card {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 24rpx; background: var(--surface); border-radius: 20rpx;
  transition: all 0.3s;
}
.bond-card.highlight {
  background: linear-gradient(135deg, var(--surface-container-lowest), rgba(177,204,197,0.2));
}
.bond-card.quiet { opacity: 0.7; }
.bond-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.bond-avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--surface-dim), var(--surface-container-high));
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600; flex-shrink: 0;
}
.bond-avatar.gold { background: linear-gradient(135deg, #334b46, #b1ccc5); color: #fff; }
.bond-avatar.ghost { opacity: 0.5; }
.bond-info { flex:1; min-width:0; }
.bond-name-row { display: flex; align-items: center; gap: 8rpx; }
.bond-name { font-size: 30rpx; font-weight: 600; }
.bond-type {
  font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 16rpx;
  background: var(--surface-container); color: var(--primary); white-space: nowrap;
}
.bond-detail { font-size: 20rpx; color: var(--secondary); display: block; margin-top: 4rpx; }
.bond-act {
  padding: 14rpx 24rpx; border-radius: 100rpx; font-size: 24rpx;
  border: 1rpx solid rgba(116,120,120,0.2); background: transparent;
  color: var(--primary); flex-shrink: 0;
}
.bond-act::after { border: none; }
.quiet-badge {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--surface-container); display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--secondary); opacity: 0.5; flex-shrink: 0;
}

.empty-bond { text-align: center; padding: 48rpx 0; font-size: 24rpx; color: var(--secondary); }

.add-bond {
  text-align: center; padding: 28rpx; margin-top: 16rpx;
  border-radius: 24rpx; border: 2rpx dashed var(--outline-variant);
  color: var(--primary); opacity: 0.55; font-size: 26rpx;
}

/* === 分享卡片 === */
.share-card {
  text-align: center; padding: 40rpx 32rpx; margin-bottom: 32rpx;
  background: var(--surface-container-lowest); border-radius: 24rpx;
  box-shadow: 0 0 40rpx 10rpx rgba(211,211,211,0.08);
  border: 1rpx solid rgba(211,211,211,0.2);
}
.share-illustration {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--surface-container-low), var(--tertiary-fixed-dim));
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 24rpx;
}
.share-icon { font-size: 56rpx; color: var(--primary); }
.share-desc { font-size: 24rpx; color: var(--secondary); display: block; line-height: 1.8; }
.share-btn {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 18rpx 40rpx; border-radius: 100rpx;
  font-size: 28rpx; letter-spacing: 0.04em;
  background: var(--primary); color: #fff; border: none; margin-top: 24rpx;
}
.share-btn::after { border: none; }
.share-btn:active { opacity: 0.85; }
.share-btn-icon { font-size: 32rpx; }

/* === 分区标题 === */
.section-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 0 16rpx;
}
.section-title { font-size: 32rpx; font-family: var(--font-display); letter-spacing: 0.03em; }
.section-count {
  font-size: 22rpx; color: var(--secondary);
  padding: 4rpx 16rpx; border-radius: 20rpx; background: var(--surface-container);
}

/* === 空状态 === */
.empty-state {
  text-align: center; padding: 48rpx 0;
}
.empty-state.large { padding: 64rpx 0; }
.empty-icon { font-size: 48rpx; color: var(--outline-variant); display: block; margin-bottom: 16rpx; }
.empty-icon-large { font-size: 72rpx; color: var(--outline-variant); display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; color: var(--secondary); display: block; }
.empty-sub {
  font-size: 22rpx; color: var(--secondary); opacity: 0.6; display: block; margin-top: 6rpx;
}
