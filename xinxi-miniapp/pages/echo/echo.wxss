.page { padding: 0 32rpx; min-height: 100vh; }
.header { padding: 36rpx 0 20rpx; }
.title { font-size: 40rpx; font-family: var(--font-display); letter-spacing: 0.04em; display: block; }
.sub { font-size: 22rpx; color: var(--secondary); margin-top: 4rpx; display: block; }

.msg-grid { display: flex; flex-direction: column; gap: 12rpx; }

/* 高亮卡片 */
.msg-card.highlight {
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(211,211,211,0.3);
  box-shadow: 0 0 20rpx rgba(211,211,211,0.15);
}

/* 普通卡片 */
.msg-card {
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  transition: all 0.3s;
}
.msg-card.unread { border-left: 4rpx solid var(--primary); }

.msg-top { display: flex; align-items: center; gap: 14rpx; margin-bottom: 12rpx; }
.msg-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #b1ccc5; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600; flex-shrink: 0; color: #06201b;
}
.msg-avatar.small { width: 56rpx; height: 56rpx; font-size: 24rpx; }
.msg-info { flex: 1; }
.msg-name { font-size: 28rpx; font-weight: 500; display: block; }
.msg-time { font-size: 20rpx; color: var(--secondary); }

.msg-body { font-size: 26rpx; color: var(--outline); line-height: 1.6; display: block; margin-bottom: 10rpx; }

.msg-tag { display: inline-block; padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 20rpx; }
.msg-tag.pending { background: var(--surface-container); color: var(--primary); }
.msg-tag.accepted { background: #cde8e1; color: #06201b; }
.msg-tag.rejected { background: var(--error-container); color: var(--on-error-container); }

.msg-actions { display: flex; gap: 10rpx; margin-top: 14rpx; }
.act-accept {
  padding: 12rpx 24rpx; border-radius: 12rpx; font-size: 24rpx;
  border: 1rpx solid #b1ccc5; color: #334b46;
  background: var(--surface-container-lowest);
}
.act-accept::after { border: none; }
.act-reject {
  padding: 12rpx 24rpx; border-radius: 12rpx; font-size: 24rpx;
  border: 1rpx solid var(--outline-variant); color: var(--secondary);
  background: var(--surface-container-lowest);
}
.act-reject::after { border: none; }

.empty-msg { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 56rpx; display: block; margin-bottom: 12rpx; }
.empty-msg text { font-size: 26rpx; color: var(--secondary); display: block; }
.empty-sub { font-size: 20rpx; opacity: 0.5; margin-top: 6rpx; }
