@font-face {
  font-family: 'Material Symbols Outlined';
  font-style: normal;
  src: url('data:font/woff2;base64,') format('woff2');
}

.ms-icon {
  font-family: 'Material Symbols Outlined';
  font-size: 48rpx;
  line-height: 1;
  font-weight: normal;
  font-style: normal;
  display: inline-block;
  letter-spacing: normal;
  word-wrap: normal;
  white-space: nowrap;
  direction: ltr;
  -webkit-font-smoothing: antialiased;
}

/* ============================================================
   心汐 · 全局设计系统
   对齐 V10/Stitch — 暖奶油色系 · 禅意留白
   ============================================================ */

page {
  /* === Surface 层级 === */
  --surface: #fdf8f8;
  --surface-bright: #fdf8f8;
  --surface-container-lowest: #ffffff;
  --surface-container-low: #f7f3f2;
  --surface-container: #f1edec;
  --surface-container-high: #ebe7e7;
  --surface-container-highest: #e5e2e1;
  --surface-dim: #ddd9d8;

  /* === Primary === */
  --primary: #171818;
  --primary-container: #2c2c2c;
  --on-primary: #ffffff;

  /* === Secondary === */
  --secondary: #5d5e5f;
  --on-secondary-container: #636465;

  /* === Tertiary (墨绿·点缀) === */
  --tertiary: #021b17;
  --tertiary-fixed-dim: #b1ccc5;

  /* === Error === */
  --error: #ba1a1a;
  --error-container: #ffdad6;
  --on-error-container: #93000a;

  /* === Coral (品牌色) === */
  --coral: #E8815B;

  /* === Outline === */
  --outline: #747878;
  --outline-variant: #c4c7c7;

  /* === 排版 === */
  --font-display: 'STSong', 'Songti SC', 'Noto Serif SC', serif;
  --font-body: 'PingFang SC', -apple-system, 'Helvetica Neue', sans-serif;

  /* === 间距 === */
  --breath-xs: 8rpx;
  --breath-sm: 16rpx;
  --breath-md: 32rpx;
  --breath-lg: 64rpx;

  /* === 阴影 === */
  --shadow-ink: 0 0 60px 20px rgba(211, 211, 211, 0.4);

  background-color: var(--surface);
  font-family: var(--font-body);
  color: var(--primary);
  font-size: 28rpx;
  line-height: 1.6;
}

/* === 卡片 === */
.card {
  background: var(--surface-container-lowest);
  border-radius: 24rpx;
  padding: var(--breath-sm);
  margin-bottom: var(--breath-sm);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* === 按钮 === */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  transition: all 0.3s;
}

.btn-primary {
  background: var(--primary);
  color: #ffffff;
  padding: 20rpx 48rpx;
}

.btn-ghost {
  background: transparent;
  border: 1.5rpx solid rgba(23, 24, 24, 0.3);
  color: var(--primary);
  padding: 20rpx 48rpx;
}

.btn-sm {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
}

.btn::after { border: none; }

/* === Toast === */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(23, 24, 24, 0.85);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.toast.show { opacity: 1; }

/* === 禅意分隔线 === */
.zen-divider {
  width: 96rpx;
  height: 1rpx;
  background: var(--outline-variant);
  margin: 16rpx auto;
  opacity: 0.4;
}

/* === V10 水墨质感 === */

/* 水墨发光 */
.ink-wash-glow {
  box-shadow: 0 0 60rpx 20rpx rgba(211, 211, 211, 0.4);
}

/* 水墨边框 */
.ink-wash-border {
  border: 1rpx solid rgba(211, 211, 211, 0.3);
  box-shadow: 0 0 20rpx rgba(211, 211, 211, 0.1);
  transition: all 0.6s ease-in-out;
}

/* 涟漪背景 */
.ripple-bg {
  background: radial-gradient(circle, rgba(211, 211, 211, 0.15) 0%, transparent 70%);
}

/* 水墨渗染 */
.ink-bleed {
  box-shadow: 0 0 40rpx 10rpx rgba(211, 211, 211, 0.15);
  border: 1rpx solid rgba(211, 211, 211, 0.2);
}

/* 鹅卵石按钮悬浮 */
.pebble-button:active {
  border-color: var(--primary);
  background: radial-gradient(circle, rgba(177, 204, 197, 0.1) 0%, transparent 100%);
}

/* brush stroke */
.brush-stroke {
  border-bottom: 2rpx solid transparent;
  border-image: linear-gradient(to right, transparent, var(--outline), transparent) 1;
}

/* === 动画 === */

/* 涟漪消散 */
@keyframes splash-ripple {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(2.5); opacity: 0; }
}
.splash-active { animation: splash-ripple 1.5s cubic-bezier(0, 0.2, 0.8, 1) forwards; }

/* 淡入 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-in { animation: fadeIn 0.5s ease-out; }
